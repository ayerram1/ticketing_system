# Database Configuration (for host/local running)
# When running with Docker Compose, Docker sets this automatically to postgresql://myuser:mypassword@db:5432/mydatabase
DATABASE_URL=postgresql://myuser:mypassword@127.0.0.1:5432/mydatabase

# Server Port
PORT=3301

# JWT Secret for local development
JWT_SECRET=development_secret_key_change_in_production

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL
FRONTEND_URL=http://localhost:3001

# SAML SSO Configuration (Optional in local development)
ASU_IDP_ISSUER=urn:mace:incommon:asu.edu
ASU_IDP_ENTRYPOINT=https://weblogin.asu.edu/idp/profile/SAML2/Redirect/SSO
SAML_SP_ENTITY_ID=https://helpdesk.asucapstonetools.com/shibboleth
SAML_CALLBACK_URL=https://helpdesk.asucapstonetools.com/api/auth/saml/callback

# PostgreSQL environment variables for Docker Compose
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
DATABASE_URL="postgresql://myuser:mypassword@127.0.0.1:5432/mydatabase" 
JWT_SECRET="secret"

# Backend Configuration
PORT=3301
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:3301

# SSO
ASU_IDP_ISSUER=urn:mace:incommon:asu.edu
ASU_IDP_ENTRYPOINT=https://weblogin.asu.edu/idp/profile/SAML2/Redirect/SSO
SAML_SP_ENTITY_ID=https://helpdesk.asucapstonetools.com/shibboleth
SAML_CALLBACK_URL=https://helpdesk.asucapstonetools.com/api/auth/saml/callback

# Cloudflare Turnstile
TURNSTILE_SECRET=your_turnstile_secret_key
TURNSTILE_SITE_KEY=0x4AAAAAAF9VvXnTwqQwdO17
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,helpdesk.asucapstonetools.com
